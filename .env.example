# Application
PORT=3000

# MySQL — use either DATABASE_URL or the split variables below (not both required)
# If using DATABASE_URL, URL-encode special characters in the password (e.g. @ → %40)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=oms
DATABASE_PASSWORD=oms
DATABASE_NAME=oms
DATABASE_URL=mysql://oms:oms@localhost:3306/oms

# Redis — use either REDIS_URL or REDIS_HOST + REDIS_PORT
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
